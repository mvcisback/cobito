<<the prose dialect>>=
/// How docs-chunk prose is authored (§6.1). Markdown is the ergonomic default
/// (SPEC §6.4); `html` is the raw-HTML escape hatch that still passes through
/// untouched, which is also what labeled/numbered islands rely on.
#[derive(Deserialize, Clone, Copy, PartialEq, Eq, Debug, Default)]
#[serde(rename_all = "lowercase")]
pub enum Dialect {
    #[default]
    Markdown,
    Html,
}
