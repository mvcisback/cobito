<<the writer and rename tests>>=
#[test]
fn writes_a_markdown_anchor_on_the_named_line() {
    let dir = std::env::temp_dir().join(format!("lit-sec-md-{}", std::process::id()));
    std::fs::create_dir_all(&dir).unwrap();
    let path = dir.join("a.nw");
    std::fs::write(&path, "@ # Title\n\n## Lexing\nprose\n").unwrap();
    apply_anchors(&path, &[(3, "k3f9".into())], Dialect::Markdown).unwrap();
    let got = std::fs::read_to_string(&path).unwrap();
    assert_eq!(got, "@ # Title\n\n## Lexing {#sec:k3f9}\nprose\n");
    std::fs::remove_dir_all(&dir).ok();
}

#[test]
fn writes_an_html_id_attribute() {
    let dir = std::env::temp_dir().join(format!("lit-sec-html-{}", std::process::id()));
    std::fs::create_dir_all(&dir).unwrap();
    let path = dir.join("a.nw");
    std::fs::write(&path, "@ <h3>Cost</h3>\n").unwrap();
    apply_anchors(&path, &[(1, "7g2A".into())], Dialect::Html).unwrap();
    let got = std::fs::read_to_string(&path).unwrap();
    assert_eq!(got, "@ <h3 id=\"sec:7g2A\">Cost</h3>\n");
    std::fs::remove_dir_all(&dir).ok();
}

#[test]
fn renames_a_named_anchor_and_reports_a_miss() {
    let dir = std::env::temp_dir().join(format!("lit-sec-rn-{}", std::process::id()));
    std::fs::create_dir_all(&dir).unwrap();
    let path = dir.join("a.nw");
    std::fs::write(&path, "## Lexing {#sec:k3f9}\n").unwrap();
    assert!(rename_anchor(&path, "k3f9", "lexing", Dialect::Markdown).unwrap());
    assert_eq!(
        std::fs::read_to_string(&path).unwrap(),
        "## Lexing {#sec:lexing}\n"
    );
    // A name that is not present changes nothing and reports the miss.
    assert!(!rename_anchor(&path, "absent", "x", Dialect::Markdown).unwrap());
    std::fs::remove_dir_all(&dir).ok();
}
