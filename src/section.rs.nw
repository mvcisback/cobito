use std::io;
use std::path::Path;

use crate::config::Dialect;
use crate::model::{DocModel, ProseSpan, SectionKind};
@
A heading and the source line that carries it. `anchored` is true when the heading
already has an id — an author `sec:` label or an anchor a past `lit lock` wrote — so
the caller skips it and never anchors a heading twice.
<<a heading site>>=
/// A heading found in a docs chunk, with the `.nw` line that carries it. `anchored`
/// is true when the heading already has an id (an author `sec:` label or a past
/// anchor), so `lit lock` skips it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct HeadingSite {
    pub file: String,
    pub line: u32,
    pub level: u8,
    pub anchored: bool,
}
@
The finder walks the model's docs sections in document order. A section starts at a
known source line, and each newline advances the line by one, so the finder tracks
the absolute source line of every prose line. It rebuilds each line from the spans,
then tests it for a heading. A code fence in Markdown hides its lines, so a `#`
inside a fenced block is not a false heading; the fence state carries across the
sections of one file, because a fence can span a code chunk.
<<find every heading in the source>>=
/// Every heading (levels 1..=3) in document order, each with its `.nw` source line.
/// Walks the model's docs sections; a Markdown code fence hides the lines inside it.
pub fn headings(doc: &DocModel, dialect: Dialect) -> Vec<HeadingSite> {
    let mut out = Vec::new();
    // A ``` fence can span a code chunk, so its state is per file, not per section.
    let mut fenced = false;
    let mut cur_file: Option<&str> = None;
    for sec in &doc.sections {
        if cur_file != Some(sec.file.as_str()) {
            cur_file = Some(sec.file.as_str());
            fenced = false;
        }
        let spans = match &sec.kind {
            SectionKind::Docs { spans } => spans,
            SectionKind::Code { .. } => continue,
        };
        let mut line = sec.line;
        let mut buf = String::new();
        for span in spans {
            match span {
                ProseSpan::Text(s) => buf.push_str(s),
                ProseSpan::Quote(s) => buf.push_str(s),
                ProseSpan::Nl => {
                    scan_line(&sec.file, line, &buf, dialect, &mut fenced, &mut out);
                    line += 1;
                    buf.clear();
                }
            }
        }
        if !buf.is_empty() {
            scan_line(&sec.file, line, &buf, dialect, &mut fenced, &mut out);
        }
    }
    out
}

fn scan_line(
    file: &str,
    line: u32,
    text: &str,
    dialect: Dialect,
    fenced: &mut bool,
    out: &mut Vec<HeadingSite>,
) {
    let found = match dialect {
        Dialect::Markdown => {
            if text.trim_start().starts_with("```") {
                *fenced = !*fenced;
                return;
            }
            if *fenced {
                return;
            }
            md_heading(text)
        }
        Dialect::Html => html_heading(text),
    };
    if let Some((level, anchored)) = found {
        out.push(HeadingSite {
            file: file.to_string(),
            line,
            level,
            anchored,
        });
    }
}
@
One line to a heading, in each dialect. A Markdown heading is one to three `#`
characters, then a space; up to three leading spaces are allowed. An HTML heading is
an `<h1>`..`<h3>` open tag. In both, an id already present makes the heading
anchored — a trailing `{#…}` attribute in Markdown, an `id=` attribute in the tag.
The weaver only makes a permalink for `h1`..`h3`, so deeper headings are ignored.
<<detect a heading in one line>>=
/// A Markdown ATX heading (`#`..`###` then a space) → its level and whether it
/// already carries a `{#…}` id.
fn md_heading(text: &str) -> Option<(u8, bool)> {
    // CommonMark allows up to three leading spaces before the hashes.
    let t = text.trim_start_matches(' ');
    let hashes = t.bytes().take_while(|&b| b == b'#').count();
    if hashes == 0 || hashes > 3 {
        return None;
    }
    let rest = &t[hashes..];
    if !rest.starts_with(' ') {
        return None;
    }
    let trimmed = rest.trim_end();
    let anchored = trimmed.ends_with('}') && trimmed.contains("{#");
    Some((hashes as u8, anchored))
}

/// An HTML `<h1>`..`<h3>` open tag → its level and whether the tag has an `id=`.
fn html_heading(text: &str) -> Option<(u8, bool)> {
    for level in 1u8..=3 {
        let open = format!("<h{level}");
        if let Some(pos) = text.find(&open) {
            let after = text[pos + open.len()..].chars().next();
            if matches!(after, Some(' ') | Some('>')) {
                let tag_end = text[pos..].find('>').map(|e| pos + e).unwrap_or(text.len());
                let anchored = text[pos..tag_end].contains("id=");
                return Some((level, anchored));
            }
        }
    }
    None
}
@
The writer takes the lines to anchor and the id to write on each, and edits the file
once. It reads the whole source, keeps every newline, and rewrites only the given
lines. A Markdown anchor is a trailing `{#sec:<id>}`; an HTML anchor is an
`id="sec:<id>"` attribute placed right after the tag name. The label the anchor
carries is `sec:<id>` — the id doubles as its own name until `lit rename-label`
gives it a human one.
<<write anchors into the source>>=
/// Write a `sec:<id>` anchor into the heading on each `(line, id)` of `path`, in
/// the given dialect. Edits only those lines; every other byte is preserved. An
/// empty edit list writes nothing.
pub fn apply_anchors(path: &Path, edits: &[(u32, String)], dialect: Dialect) -> io::Result<()> {
    if edits.is_empty() {
        return Ok(());
    }
    let content = std::fs::read_to_string(path)?;
    let mut lines: Vec<String> = content.split_inclusive('\n').map(str::to_string).collect();
    for (line, id) in edits {
        let idx = (*line as usize) - 1;
        let (body, nl) = split_nl(&lines[idx]);
        lines[idx] = match dialect {
            Dialect::Markdown => format!("{} {{#sec:{id}}}{nl}", body.trim_end()),
            Dialect::Html => format!("{}{nl}", insert_html_id(body, id)),
        };
    }
    std::fs::write(path, lines.concat())
}

/// Split a stored line into its body and its trailing newline (empty at EOF).
fn split_nl(line: &str) -> (&str, &str) {
    match line.strip_suffix('\n') {
        Some(body) => (body, "\n"),
        None => (line, ""),
    }
}

/// Insert ` id="sec:<id>"` right after the `<hN` tag name.
fn insert_html_id(body: &str, id: &str) -> String {
    for level in 1u8..=3 {
        let open = format!("<h{level}");
        if let Some(pos) = body.find(&open) {
            let at = pos + open.len();
            return format!("{} id=\"sec:{id}\"{}", &body[..at], &body[at..]);
        }
    }
    body.to_string()
}
@
The renamer swaps one anchor for another. `lit rename-label` gives an id a human
name, so the source anchor changes from `sec:<old>` to `sec:<new>` while the frozen
id stays the same. The names are unique strings, so a plain replace hits only the
one anchor. It returns whether it changed the source, so the caller can report a
miss instead of a silent no-op.
<<rename an anchor in the source>>=
/// Rewrite a heading anchor in `path` from `sec:<old>` to `sec:<new>`, in the given
/// dialect. `old`/`new` are the bare names after `sec:`. Returns whether it changed
/// a byte, so the caller can report a missing anchor.
pub fn rename_anchor(path: &Path, old: &str, new: &str, dialect: Dialect) -> io::Result<bool> {
    let content = std::fs::read_to_string(path)?;
    let (from, to) = match dialect {
        Dialect::Markdown => (format!("{{#sec:{old}}}"), format!("{{#sec:{new}}}")),
        Dialect::Html => (format!("id=\"sec:{old}\""), format!("id=\"sec:{new}\"")),
    };
    if !content.contains(&from) {
        return Ok(false);
    }
    std::fs::write(path, content.replace(&from, &to))?;
    Ok(true)
}
@
The tests pin the round trip. The finder reports the right level, source line, and
anchored state in each dialect, skips a `#` inside a fence, and carries a fence
across a code chunk. The writer adds an anchor without disturbing the rest of the
line, in each dialect. The renamer swaps a named anchor and reports a miss.
