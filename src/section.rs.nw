<<the finder tests>>=
#[test]
fn finds_markdown_headings_with_source_lines() {
    let doc = model(vec![docs(
        "a.nw",
        1,
        "# Title\n\n## Lexing\n\nprose\n\n### Cost {#sec:cost}",
    )]);
    let hs = headings(&doc, Dialect::Markdown);
    assert_eq!(
        hs,
        vec![
            HeadingSite { file: "a.nw".into(), line: 1, level: 1, anchored: false },
            HeadingSite { file: "a.nw".into(), line: 3, level: 2, anchored: false },
            HeadingSite { file: "a.nw".into(), line: 7, level: 3, anchored: true },
        ]
    );
}

#[test]
fn a_hash_inside_a_fence_is_not_a_heading() {
    let doc = model(vec![docs(
        "a.nw",
        1,
        "## Real\n\n```\n## not a heading\n```\n\n## Also real",
    )]);
    let hs = headings(&doc, Dialect::Markdown);
    let lines: Vec<u32> = hs.iter().map(|h| h.line).collect();
    assert_eq!(lines, vec![1, 7], "the fenced `##` is skipped");
}

#[test]
fn finds_html_headings_and_reads_the_id() {
    let doc = model(vec![docs(
        "a.nw",
        4,
        "<h1>Title</h1>\n<h2 id=\"sec:lexing\">Lexing</h2>\n<h3>Cost</h3>",
    )]);
    let hs = headings(&doc, Dialect::Html);
    assert_eq!(
        hs,
        vec![
            HeadingSite { file: "a.nw".into(), line: 4, level: 1, anchored: false },
            HeadingSite { file: "a.nw".into(), line: 5, level: 2, anchored: true },
            HeadingSite { file: "a.nw".into(), line: 6, level: 3, anchored: false },
        ]
    );
}
