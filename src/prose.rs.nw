All four delimiter pairs are recognized, and display versus inline is tracked.
<<all four delimiter pairs>>=
#[test]
fn display_and_inline_delimiters() {
    let (_, math) = extract(r"$x$ and $$y$$ and \(z\) and \[w\]");
    assert_eq!(
        math,
        vec![
            Math {
                source: "x".into(),
                display: false
            },
            Math {
                source: "y".into(),
                display: true
            },
            Math {
                source: "z".into(),
                display: false
            },
            Math {
                source: "w".into(),
                display: true
            },
        ]
    );
}
