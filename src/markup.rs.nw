Three free helpers do the small pattern jobs the scanners need.

`code_def_name` returns the name of a `@<<name@>>=` definition line, or `None`.
The line must start with `@<<`, hold `>>=`, and have nothing but that after the
name.
<<the code helpers>>=
/// The name in a `@<<name@>>=` definition line, or `None`.
fn code_def_name(l: &str) -> Option<String> {
    let rest = l.strip_prefix("<<")?;
    let end = rest.find(">>=")?;
    if !rest[end + 3..].trim().is_empty() {
        return None;
    }
    Some(rest[..end].to_string())
}

/// The text after an `@ ` control directive keyword, or `None`. `%def` and
/// `%def x` both match; the returned rest is empty or the ids.
fn def_directive<'a>(content: &'a str, key: &str) -> Option<&'a str> {
    if content == key {
        return Some("");
    }
    content.strip_prefix(key).filter(|r| r.starts_with(' '))
}

/// True if a quote close `]]` starts at `i`, greedy: a `]]` whose next character
/// is not `]`, so `[[v[[0]]]]` keeps its inner brackets.
fn is_quote_close(chars: &[char], i: usize) -> bool {
    chars[i] == ']' && chars.get(i + 1) == Some(&']') && chars.get(i + 2) != Some(&']')
}

/// The bracket char of an escape `@<<` or `@>>` at `i`, or `None`. The escape is
/// a doubled bracket only: a single `@<` or `@>` is literal.
fn escaped_bracket(chars: &[char], i: usize) -> Option<char> {
    if chars[i] == '@' && i + 2 < chars.len() {
        let b = chars[i + 1];
        if (b == '<' || b == '>') && chars[i + 2] == b {
            return Some(b);
        }
    }
    None
}

/// The index of the closing `>>` of a chunk use that starts at `from`, or `None`.
fn use_close(chars: &[char], from: usize) -> Option<usize> {
    let mut i = from;
    while i + 1 < chars.len() {
        if chars[i] == '>' && chars[i + 1] == '>' {
            return Some(i);
        }
        i += 1;
    }
    None
}
