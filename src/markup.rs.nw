The grammar is the runnable copy of §sec:read-grammar. Each rule returns the atoms
of one line. A `pub rule` is one the lowering calls: `classify` sorts a line into
its kind, `code_line` tokenizes a code line, and `docs_out`/`docs_in` tokenize a
documentation line from each quote state.
<<the peg grammar>>=
peg::parser! {
    grammar nw() for str {
        pub rule classify() -> Line
            = d:def_line() { Line::Def(d) }
            / c:control_line() { c }
            / p:$([_]*) { Line::Plain(p.to_string()) }

        rule def_line() -> String
            = "@<<" n:$((!"@>>=" [_])*) "@>>=" [' ' | '\t']* ![_] { n.to_string() }

        rule control_line() -> Line
            = "@" ![_] { Line::Control(String::new()) }
            / "@" [' ' | '\t'] r:$([_]*) { Line::Control(r.to_string()) }

        pub rule code_line() -> Vec<Seg>
            = run:code_run() rest:code_after()* {
                let mut v = vec![Seg::Text(run)];
                for r in rest {
                    v.extend(r);
                }
                v
            }

        rule code_after() -> Vec<Seg>
            = u:use_tok() run:code_run() { vec![Seg::Use(u), Seg::Text(run)] }
            / lone:$("@<<") run:code_run() { vec![Seg::Text(format!("{lone}{run}"))] }

        rule use_tok() -> String
            = "@<<" n:$((!"@>>" [_])*) "@>>" { n.to_string() }

        rule code_run() -> String
            = cs:code_run_ch()* { cs.concat() }

        rule code_run_ch() -> String
            = e:escape() { e }
            / !"@<<" c:$([_]) { c.to_string() }

        pub rule docs_out() -> (Vec<Seg>, bool)
            = run:docs_run() rest:docs_block()* {
                let mut v = vec![Seg::Text(run)];
                let mut open = false;
                for (segs, ended) in rest {
                    v.extend(segs);
                    open = ended;
                }
                (v, open)
            }

        pub rule docs_in() -> (Vec<Seg>, bool)
            = content:docs_qrun() tail:docs_reopen()? {
                match tail {
                    Some((mut segs, ended)) => {
                        let mut v = vec![Seg::Text(content), Seg::Close];
                        v.append(&mut segs);
                        (v, ended)
                    }
                    None => (vec![Seg::Text(content)], true),
                }
            }

        rule docs_reopen() -> (Vec<Seg>, bool)
            = docs_close() rest:docs_out() { rest }

        rule docs_block() -> (Vec<Seg>, bool)
            = "[[" content:docs_qrun() close:docs_close()? post:docs_run() {
                let mut v = vec![Seg::Open, Seg::Text(content)];
                match close {
                    Some(()) => {
                        v.push(Seg::Close);
                        v.push(Seg::Text(post));
                        (v, false)
                    }
                    None => (v, true),
                }
            }

        rule docs_close() -> () = "]]" !"]" { () }

        rule docs_run() -> String
            = cs:docs_run_ch()* { cs.concat() }

        rule docs_run_ch() -> String
            = e:escape() { e }
            / !"[[" c:$([_]) { c.to_string() }

        rule docs_qrun() -> String
            = cs:docs_qrun_ch()* { cs.concat() }

        rule docs_qrun_ch() -> String
            = e:escape() { e }
            / !docs_close() c:$([_]) { c.to_string() }

        rule escape() -> String
            = "@@<<" { "@<<".to_string() }
            / "@@>>" { "@>>".to_string() }
    }
}
@
The lowering holds the same state as the hand reader (the counter, the open chunk,
the `%def` wait, the open quote) and turns the atoms of each line into events. It is
a second copy of the state rules of §sec:read-rules, on purpose: an independent copy
catches a mistake a shared one would hide.
<<the oracle lowering>>=
#[derive(Default)]
struct Oracle {
    out: Vec<Event>,
    counter: u32,
    open: Option<bool>,
    cur: u32,
    defs_pending: bool,
    in_quote: bool,
}

impl Oracle {
    fn open_docs(&mut self) {
        let n = self.counter;
        self.counter += 1;
        self.cur = n;
        self.open = Some(false);
        self.out.push(Event::BeginDocs(n));
    }

    fn open_code(&mut self) {
        let n = self.counter;
        self.counter += 1;
        self.cur = n;
        self.open = Some(true);
        self.out.push(Event::BeginCode(n));
    }

    fn close_current(&mut self) {
        self.defs_pending = false;
        if let Some(code) = self.open.take() {
            let n = self.cur;
            self.out.push(if code {
                Event::EndCode(n)
            } else {
                Event::EndDocs(n)
            });
        }
    }

    fn emit_segs(&mut self, segs: Vec<Seg>) {
        let n = segs.len();
        for (i, seg) in segs.into_iter().enumerate() {
            let last = i + 1 == n;
            match seg {
                Seg::Text(s) => {
                    if last || !s.is_empty() {
                        self.out.push(Event::Text(s));
                    }
                }
                Seg::Use(u) => self.out.push(Event::Use(u)),
                Seg::Open => self.out.push(Event::Quote),
                Seg::Close => self.out.push(Event::EndQuote),
            }
        }
        self.out.push(Event::Nl);
    }

    fn code_emit(&mut self, l: &str) {
        let segs = nw::code_line(l).expect("a code line tokenizes");
        self.emit_segs(segs);
    }

    fn docs_emit(&mut self, l: &str) {
        let (segs, ended) = if self.in_quote {
            nw::docs_in(l).expect("a docs line tokenizes")
        } else {
            nw::docs_out(l).expect("a docs line tokenizes")
        };
        self.in_quote = ended;
        self.emit_segs(segs);
    }

    fn index(&mut self, ids: &str, defn: bool) {
        if self.open != Some(true) {
            self.close_current();
            self.open_docs();
            self.docs_emit(if defn { "%def" } else { "%use" });
            return;
        }
        for id in ids.split_whitespace() {
            self.out.push(if defn {
                Event::IndexDefn(id.to_string())
            } else {
                Event::IndexUse(id.to_string())
            });
        }
        self.out.push(Event::IndexNl);
        self.defs_pending = true;
    }

    fn line(&mut self, l: &str) {
        match nw::classify(l).expect("every line classifies") {
            Line::Def(name) => {
                self.close_current();
                self.open_code();
                self.out.push(Event::Defn(name));
                self.out.push(Event::Nl);
            }
            Line::Control(content) => {
                if let Some(rest) = directive(&content, "%def") {
                    self.index(rest, true);
                } else if let Some(rest) = directive(&content, "%use") {
                    self.index(rest, false);
                } else {
                    self.close_current();
                    self.open_docs();
                    self.docs_emit(&content);
                }
            }
            Line::Plain(l) => {
                if self.defs_pending {
                    self.close_current();
                }
                if self.open.is_none() {
                    self.open_docs();
                }
                if self.open == Some(true) {
                    self.code_emit(&l);
                } else {
                    self.docs_emit(&l);
                }
            }
        }
    }

    fn file(&mut self, path: &str, text: &str) {
        self.out.push(Event::File(path.to_string()));
        self.open_docs();
        for line in text.lines() {
            self.line(line);
        }
        self.close_current();
    }
}

fn directive<'a>(content: &'a str, key: &str) -> Option<&'a str> {
    if content == key {
        return Some("");
    }
    content.strip_prefix(key).filter(|r| r.starts_with(' '))
}

fn oracle_read(files: &[&str]) -> Vec<Event> {
    let mut o = Oracle::default();
    for f in files {
        let text = std::fs::read_to_string(f).expect("the fixture reads");
        o.file(f, &text);
    }
    o.out
}
@
The oracle test mirrors the reader test: for each fixture it reads the `.nw` with the
grammar path and compares to the pinned `markup` output. When both readers pass, the
hand reader and the grammar reader agree with real `markup` for the whole corpus.
<<the oracle tests>>=
fn same_as_markup(nw: &str, markup: &str) {
    let ours = oracle_read(&[nw]);
    let oracle = parse(markup).expect("the oracle markup parses");
    assert_eq!(ours, oracle, "peg oracle diverged from markup for {nw}");
}

#[test]
fn oracle_matches_markup() {
    same_as_markup("fixtures/hello.nw", include_str!("../fixtures/hello.markup"));
    same_as_markup("fixtures/book.nw", include_str!("../fixtures/book.markup"));
    same_as_markup("fixtures/md.nw", include_str!("../fixtures/md.markup"));
    same_as_markup("fixtures/hl.nw", include_str!("../fixtures/hl.markup"));
    same_as_markup(
        "fixtures/sections.nw",
        include_str!("../fixtures/sections.markup"),
    );
    same_as_markup("fixtures/tx.nw", include_str!("../fixtures/tx.markup"));
    same_as_markup("fixtures/txf.nw", include_str!("../fixtures/txf.markup"));
    same_as_markup("fixtures/quote.nw", include_str!("../fixtures/quote.markup"));
}
