fn file(&mut self, path: &str, text: &str) {
    self.push(Event::File(path.to_string()));
    self.open_docs();
    for line in text.lines() {
        self.line(line);
    }
    self.close_current();
}
@
The emit helpers keep the walk readable. `push` adds one event; `text` adds a
text token. `open_docs`/`open_code` take the next number and emit the `@begin`.
`close_current` emits the `@end` for the open chunk and clears the `%def` wait.
<<open and close a chunk>>=
@
<<the emit helpers>>=
fn push(&mut self, e: Event) {
    self.out.push(e);
}

fn text(&mut self, s: &str) {
    self.out.push(Event::Text(s.to_string()));
}

fn open_docs(&mut self) {
    let n = self.counter;
    self.counter += 1;
    self.cur = n;
    self.open = Some(false);
    self.push(Event::BeginDocs(n));
}

fn open_code(&mut self) {
    let n = self.counter;
    self.counter += 1;
    self.cur = n;
    self.open = Some(true);
    self.push(Event::BeginCode(n));
}

fn close_current(&mut self) {
    self.defs_pending = false;
    if let Some(code) = self.open.take() {
        let n = self.cur;
        self.push(if code {
            Event::EndCode(n)
        } else {
            Event::EndDocs(n)
        });
    }
}
@
The dispatch decides what one line is. A `@<<name@>>=` line opens a code chunk. An
`@ ` line (or bare `@`) is a control: `%def`/`%use` add index entries to the open
code chunk, anything else opens a documentation chunk. Every other line continues
the open chunk — opening a fresh documentation chunk first if a `%def` just
closed the code chunk.
<<dispatch one line>>=
@
<<the line dispatch>>=
fn line(&mut self, l: &str) {
    if let Some(name) = code_def_name(l) {
        self.close_current();
        self.open_code();
        self.push(Event::Defn(name));
        self.push(Event::Nl);
        return;
    }
    if l == "@" || l.starts_with("@ ") || l.starts_with("@\t") {
        let content = if l == "@" { "" } else { &l[2..] };
        if let Some(rest) = def_directive(content, "%def") {
            self.index_directive(rest, true);
            return;
        }
        if let Some(rest) = def_directive(content, "%use") {
            self.index_directive(rest, false);
            return;
        }
        self.close_current();
        self.open_docs();
        self.docs_line(content);
        return;
    }
    if self.defs_pending {
        self.close_current();
    }
    if self.open.is_none() {
        self.open_docs();
    }
    if self.open == Some(true) {
        self.code_line(l);
    } else {
        self.docs_line(l);
    }
}

/// Add index entries to the open code chunk and wait to close it. If no code
/// chunk is open, the directive is just documentation text.
fn index_directive(&mut self, ids: &str, defn: bool) {
    if self.open != Some(true) {
        self.close_current();
        self.open_docs();
        self.docs_line(if defn { "%def" } else { "%use" });
        return;
    }
    for id in ids.split_whitespace() {
        self.push(if defn {
            Event::IndexDefn(id.to_string())
        } else {
            Event::IndexUse(id.to_string())
        });
    }
    self.push(Event::IndexNl);
    self.defs_pending = true;
}
@
A documentation line splits on `[[quoted code]]`. Two open brackets start a quote
and the first `]]` whose next character is not `]` closes it. A quote can run over
more than one line, so the scanner keeps the open state in `in_quote` and each
line ends with one `@nl`, whether the quote is open or not.

An `@` before a doubled bracket is an escape: the reader drops the `@` and keeps
the two brackets, so `@<<name@>>` in prose is the literal text `@<<name@>>`, not a
use. A single `@<` or `@>` is literal, `@` and all. The escape works inside a
quote too. The scanner flushes the run before a quote open when the run is not
empty, and it always flushes the trailing run at the end of the line, even when
that run is empty. It flushes the run before a quote close only when the run is
not empty.
<<the documentation scanner>>=
@
<<scan a documentation line>>=
fn docs_line(&mut self, l: &str) {
    let chars: Vec<char> = l.chars().collect();
    let mut i = 0;
    let mut seg = String::new();
    while i < chars.len() {
        if self.in_quote {
            if is_quote_close(&chars, i) {
                if !seg.is_empty() {
                    self.text(&seg);
                }
                seg.clear();
                self.push(Event::EndQuote);
                self.in_quote = false;
                i += 2;
                continue;
            }
            if let Some(b) = escaped_bracket(&chars, i) {
                seg.push(b);
                seg.push(b);
                i += 3;
                continue;
            }
            seg.push(chars[i]);
            i += 1;
            continue;
        }
        if let Some(b) = escaped_bracket(&chars, i) {
            seg.push(b);
            seg.push(b);
            i += 3;
            continue;
        }
        if chars[i] == '[' && i + 1 < chars.len() && chars[i + 1] == '[' {
            if !seg.is_empty() {
                self.text(&seg);
            }
            seg.clear();
            self.push(Event::Quote);
            self.in_quote = true;
            i += 2;
            continue;
        }
        seg.push(chars[i]);
        i += 1;
    }
    self.text(&seg);
    self.push(Event::Nl);
}
@
A code line splits on `@<<name@>>` uses. An `@` before a doubled bracket drops
the `@` and keeps the two brackets, so an escaped `@<<` is the literal text `@<<`
and starts no use. A single `@<` or `@>` is literal, `@` and all. An unescaped
`@<<` with no later `>>` is literal, but `markup` still breaks the text token
there: it flushes the run before the `@<<` and starts a new run that begins with
the `@<<`. The scanner flushes the text run before each use or literal `@<<` when
the run is not empty, and always flushes the trailing run, even when it is empty.
One `@nl` ends the line.
<<the code scanner>>=
@
<<scan a code line>>=
fn code_line(&mut self, l: &str) {
    let chars: Vec<char> = l.chars().collect();
    let mut i = 0;
    let mut seg = String::new();
    while i < chars.len() {
        if let Some(b) = escaped_bracket(&chars, i) {
            seg.push(b);
            seg.push(b);
            i += 3;
            continue;
        }
        if chars[i] == '<' && i + 1 < chars.len() && chars[i + 1] == '<' {
            if !seg.is_empty() {
                self.text(&seg);
            }
            seg.clear();
            if let Some(end) = use_close(&chars, i + 2) {
                let name: String = chars[i + 2..end].iter().collect();
                self.push(Event::Use(name));
                i = end + 2;
            } else {
                seg.push('<');
                seg.push('<');
                i += 2;
            }
            continue;
        }
        seg.push(chars[i]);
        i += 1;
    }
    self.text(&seg);
    self.push(Event::Nl);
}
