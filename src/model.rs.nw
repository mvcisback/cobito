#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ProseSpan {
    Text(String),
    Nl,
    Quote(String),
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CodeSpan {
    Text(String),
    Nl,
    Use { name: String },
}
