    Code {
        name: String,
        continues: bool,
        spans: Vec<CodeSpan>,
        /// `@index defn` names; unused until the identifier index lands.
        index_defs: Vec<String>,
    },
}

#[derive(Debug, Clone, PartialEq, Eq)]
