@begin code 7
@defn flake.nix
@nl
@text {
@nl
@text   description = "a tiny flake";
@nl
@text   outputs = { self, nixpkgs }: {
@nl
@text     packages.x86_64-linux.default = 
@use packages
@text ;
@nl
@text   };
@nl
@text }
@nl
@end code 7
